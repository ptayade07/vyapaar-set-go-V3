generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerTransactionType {
  UDHAAR
  PAYMENT
  ADVANCE
}

enum SupplierTransactionType {
  CREDIT
  PAYMENT
}

model Shop {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  logoUrl   String?
  createdAt DateTime @default(now())

  users       User[]
  customers   Customer[]
  suppliers   Supplier[]
  items       InventoryItem[]
  notes       Note[]
  settings    AppSetting[]
  openingCash OpeningCash[]

  customerTransactions CustomerTransaction[]
  supplierTransactions SupplierTransaction[]
}

// One shopkeeper login per shop for now (Stage 2 scope). shopId is a plain FK, not unique, so a
// shop having multiple staff logins later doesn't need a migration -- Stage 2 just never creates
// more than one User per Shop.
model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  shopId             String
  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt          DateTime            @default(now())
  passwordResetTokens PasswordResetToken[]

  @@index([shopId])
}

// Pilot-scale rate limits, not real abuse infrastructure -- see PRODUCTION_STAGES.md. ipHash is a
// hash of the caller's IP, not the raw address, so these tables don't become a second place raw
// IPs are stored. Kept as separate tables per action (rather than one shared table) so unrelated
// actions -- signing up, logging in, requesting a password reset -- don't silently share one
// budget; see backend/lib/rate-limit.ts for the shared counting/recording logic all three use.
model SignupAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

model PasswordResetAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// tokenHash, not the raw token -- mirrors passwordHash's own reasoning: a database leak alone
// shouldn't be enough to reset anyone's password. The raw token only ever exists in the emailed
// link and briefly in memory while handling that request.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Customer {
  id           String                @id @default(cuid())
  shopId       String
  shop         Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  note         String?
  balancePaise Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  transactions CustomerTransaction[]
  notes        Note[]

  @@index([shopId])
  @@index([name])
  @@index([phone])
}

model CustomerTransaction {
  id                String                  @id @default(cuid())
  shopId            String
  shop              Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type              CustomerTransactionType
  amountPaise       Int
  description       String?
  photoUrl          String?
  balanceAfterPaise Int
  createdAt         DateTime                @default(now())

  @@index([shopId, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
}

model Supplier {
  id           String                @id @default(cuid())
  shopId       String
  shop         Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  note         String?
  balancePaise Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  transactions SupplierTransaction[]

  @@index([shopId])
  @@index([name])
}

model SupplierTransaction {
  id                String                  @id @default(cuid())
  shopId            String
  shop              Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type              SupplierTransactionType
  amountPaise       Int
  description       String?
  dueDate           DateTime?
  balanceAfterPaise Int
  createdAt         DateTime                @default(now())

  @@index([shopId, createdAt])
  @@index([supplierId, createdAt])
  @@index([createdAt])
  @@index([dueDate])
}

model InventoryItem {
  id                 String   @id @default(cuid())
  shopId             String
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name               String
  quantity           Int      @default(0)
  purchasePricePaise Int
  sellingPricePaise  Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([shopId])
  @@index([name])
}

model AppSetting {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  key    String
  value  String

  @@unique([shopId, key])
}

model OpeningCash {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date        String
  amountPaise Int
  updatedAt   DateTime @updatedAt

  @@unique([shopId, date])
}

model Note {
  id           String    @id @default(cuid())
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title        String
  text         String?
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reminderDate DateTime?
  done         Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([shopId])
  @@index([reminderDate])
  @@index([customerId])
}
