# Use Neon's POOLED connection string (hostname has "-pooler" in it) plus pgbouncer=true --
# the direct connection can't handle this app's concurrent Server Action traffic and will
# eventually throw "Unable to start a transaction in the given time". connection_limit=10 and
# pool_timeout=20 avoid a different failure mode: at the default connection_limit=1 some pages
# (the Dashboard fires 8 queries in parallel) will hit "Timed out fetching a new connection from
# the connection pool" under normal load. See README's Neon section for the full story, including
# why occasional multi-second first-request latency is expected Neon free-tier behavior, not a bug.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/vyapaar_set_go?sslmode=require&pgbouncer=true&connection_limit=10&pool_timeout=20"

# Optional. Only used for the Hisaab page's AI end-of-day summary. The app works fully without
# this — leave it unset to use the deterministic templated summary instead.
OPENAI_API_KEY=

# Optional. A Vercel Blob read-write token, used to store customer transaction receipt photos.
# Leave unset to skip photo attachments entirely — the attach-photo control is hidden and nothing
# else is affected.
BLOB_READ_WRITE_TOKEN=

# Required (Stage 2+). Signs the login session cookie (backend/lib/session.ts) -- anyone with this
# value could forge a valid session for any user, so treat it like a password and never commit the
# real value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Required for password-reset emails to send (backend/lib/email.ts). Get a free key at
# resend.com. Without a verified domain, Resend only delivers to the email address the Resend
# account itself was signed up with -- the reset flow still works end to end (token generation,
# the /reset-password page, the actual password change), but real emails to other shopkeepers
# won't land until a domain is verified. Leave unset and the app still runs; requesting a reset
# just logs an error server-side instead of sending anything.
RESEND_API_KEY=
