# Use Neon's POOLED connection string (hostname has "-pooler" in it) plus pgbouncer=true --
# the direct connection can't handle this app's concurrent Server Action traffic and will
# eventually throw "Unable to start a transaction in the given time". See README's Neon section.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/vyapaar_set_go?sslmode=require&pgbouncer=true"

# Optional. Only used as a fallback when the Dashboard quick-entry parser can't understand a
# sentence deterministically. The app works fully without this — leave it unset to skip AI parsing.
OPENAI_API_KEY=

# Optional. A Vercel Blob read-write token, used to store customer transaction receipt photos.
# Leave unset to skip photo attachments entirely — the attach-photo control is hidden and nothing
# else is affected.
BLOB_READ_WRITE_TOKEN=
